{
  "name": "pr-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurable LLM PR review and fix loop using a separate workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/metaufiq/pr-review.git"
  },
  "bin": {
    "review-pr": "dist/bin/review-pr.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "husky && npm run build",
    "review": "npm run build && node dist/bin/review-pr.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
