# Relative environment paths resolve from this tool's repository, not your shell.
PR_REVIEW_DEV_DIR=../dev
# Omit to save under <dev-dir>/sessions/pr-reviews/.
# PR_REVIEW_REPORTS_DIR=./sessions/pr-reviews
# Maximum review/fix rounds. --max-rounds overrides this value.
PR_REVIEW_MAX_ROUNDS=5

# Exactly two slots: first reviews; second verifies findings and fixes code.
# Providers: claude or codex. Ready fixes are committed and pushed to the PR.
# Omit model to use the provider's configured model.
PR_REVIEW_REVIEWERS='[{"provider":"claude"},{"provider":"codex"}]'
# Example with explicit models (use IDs available to your CLI account):
# PR_REVIEW_REVIEWERS='[{"provider":"claude","model":"opus"},{"provider":"claude","model":"sonnet"}]'
